<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="int_purchase_order_view_tree_inh_pci" model="ir.ui.view">
        <field name="name">int.purchase.order.view.tree.inh.pci</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">id desc</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="currency_id" invisible="0"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_kpis_tree_inh_pci" model="ir.ui.view">
        <field name="name">purchase.order.inherit.pci.purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">id desc</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="currency_id" invisible="0"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_tree_inh_pci" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.inh.pci</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase_order_line_menu.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_subtotal']" position="after">
                <field name="currency_id" invisible="0"/>
            </xpath>
        </field>
    </record>

</odoo>
